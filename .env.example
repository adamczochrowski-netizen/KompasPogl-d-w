# Skopiuj ten plik jako ".env" (w tym samym folderze) i wpisz swoje klucze.
# Plik .env nie jest wysyłany do przeglądarki — czyta go tylko server.py.

# ElevenLabs — naturalny głos i rozpoznawanie mowy (https://elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=
# Opcjonalnie: inny głos (ID z biblioteki głosów ElevenLabs) i modele
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2

# Claude — rozumienie swobodnych odpowiedzi (https://platform.claude.com → API Keys)
# Wymaga też: pip install anthropic
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# KOMPAS_PORT=8765
